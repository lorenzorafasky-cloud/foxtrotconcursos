{
  "name": "foxtrot-concursos",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo da plataforma Foxtrot Concursos.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:api": "pnpm --filter @foxtrot/api dev",
    "dev:worker": "pnpm --filter @foxtrot/worker dev",
    "dev:aluno": "pnpm --filter @foxtrot/aluno dev",
    "dev:admin": "pnpm --filter @foxtrot/admin dev",
    "dev:professor": "pnpm --filter @foxtrot/professor dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @foxtrot/database db:generate",
    "db:migrate": "pnpm --filter @foxtrot/database db:migrate",
    "db:seed": "pnpm --filter @foxtrot/database db:seed",
    "openapi:export": "pnpm --filter @foxtrot/api openapi:export",
    "format": "prettier --write .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.17.10",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
