generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  ADMIN_MASTER
  PROFESSOR
  ALUNO_ILIMITADO
  ALUNO_CURSO_ESPECIFICO
}

enum CourseStatus {
  PRE_EDITAL
  POS_EDITAL
}

enum EntitlementType {
  UNLIMITED
  COURSE
  QUESTIONS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum LessonAssetType {
  VIDEO
  TRANSCRIPT
  SUMMARY
  SLIDE
  PDF
  THUMBNAIL
}

enum QuestionKind {
  MULTIPLE_CHOICE
  TRUE_FALSE
  DISCURSIVE
}

enum DifficultyVote {
  EASY
  MEDIUM
  HARD
}

enum RelevanceVote {
  RELEVANT
  NOT_RELEVANT
}

enum SimulationStatus {
  IN_PROGRESS
  SUBMITTED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  STARRED
}

enum FocusMode {
  FREE
  POMODORO
}

enum FeatureFlagKey {
  PSYCHOLOGY
  MENTAL_SUPPORT
  RECREIO
  LIVE_CLASSES
}

enum NotificationType {
  SYSTEM
  ACHIEVEMENT
  CHALLENGE
  RANKING
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum AiJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum AiReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DataSubjectRequestType {
  ACCESS
  CORRECTION
  DELETION
  PORTABILITY
  ANONYMIZATION
  CONSENT_WITHDRAWAL
  AUTOMATED_DECISION_REVIEW
}

enum DataSubjectRequestStatus {
  OPEN
  IN_REVIEW
  COMPLETED
  REJECTED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  fullName           String
  nickname           String              @unique
  avatarUrl          String?
  emailVerifiedAt    DateTime?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean             @default(false)
  onboardingComplete Boolean             @default(false)
  streakFreezes      Int                 @default(1)
  emailNotifications Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  roles              UserRole[]
  permissions        UserPermission[]
  backupCodes        BackupCode[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens      RefreshToken[]
  onboarding         OnboardingProfile?
  courseEnrollments  CourseEnrollment[]
  entitlements       Entitlement[]
  ratings            LessonRating[]
  progress           LessonProgress[]
  questionAttempts   QuestionAttempt[]
  questionReactions  QuestionReaction[]
  questionFavorites  QuestionFavorite[]
  simulations        Simulation[]
  answers            QuestionAnswer[]
  answerVotes        QuestionAnswerVote[]
  streakFreezeUses   StreakFreezeUse[]
  notes              Note[]
  lists              StudyList[]
  studyGoals         StudyGoal[]
  productivityPreference UserProductivityPreference?
  focusSessions      FocusSession[]
  flashcards         Flashcard[]
  postIts            PostIt[]
  xpEvents           XpEvent[]
  achievements       UserAchievement[]
  challengeParticipants ChallengeParticipant[]
  notifications      Notification[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  impersonatedLogs   AuditLog[]          @relation("AuditSubject")
  payments           Payment[]
  subscriptions      Subscription[]
  couponRedemptions  CouponRedemption[]
  aiUsageEvents      AiUsageEvent[]
  aiJobs             AiAutomationJob[]
  aiReviews          AiReviewItem[]
  privacyConsents    PrivacyConsent[]
  dataSubjectRequests DataSubjectRequest[]
  teachingSubjects   ProfessorSubject[]
  taughtLessons      Lesson[]
  lessonDoubts       LessonDoubt[]
  essaySubmissions   EssaySubmission[]   @relation("EssayStudent")
  essayCorrections   EssaySubmission[]   @relation("EssayTeacher")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
  users       UserPermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OnboardingProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  age                    Int
  studyExperience        String
  careerGoal             String
  targetExamId           String?
  platformGoals          String[]
  dailyNetStudyGoalMins  Int
  weeklyQuestionGoal     Int      @default(150)
  examDate               DateTime?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetExam             Exam?    @relation(fields: [targetExamId], references: [id])
}

model Board {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
  courses   Course[]
  exams     Exam[]
}

model Career {
  id        String     @id @default(cuid())
  name      String     @unique
  exams     Exam[]
  courses   Course[]
  questions Question[]
}

model Institution {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
}

model Position {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
}

model Subject {
  id          String             @id @default(cuid())
  name        String             @unique
  topics      Topic[]
  lessons     Lesson[]
  questions   Question[]
  professors  ProfessorSubject[]
}

model Topic {
  id          String     @id @default(cuid())
  subjectId   String
  name        String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  questions   Question[]

  @@unique([subjectId, name])
}

model Exam {
  id          String              @id @default(cuid())
  name        String
  careerId    String
  boardId     String?
  examDate    DateTime?
  career      Career             @relation(fields: [careerId], references: [id])
  board       Board?             @relation(fields: [boardId], references: [id])
  onboarding  OnboardingProfile[]
}

model Course {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  description     String
  status          CourseStatus
  careerId        String
  boardId         String?
  area            String
  coverImageUrl   String?
  workloadMinutes Int            @default(0)
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  career          Career         @relation(fields: [careerId], references: [id])
  board           Board?         @relation(fields: [boardId], references: [id])
  modules         CourseModule[]
  enrollments     CourseEnrollment[]
  entitlements    Entitlement[]
  payments        Payment[]
  plans           Plan[]

  @@index([careerId, status])
}

model CourseEnrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, createdAt])
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  subjectId       String
  topicId         String?
  teacherId       String?
  title           String
  slug            String
  description     String
  position        Int
  streamVideoUid  String?
  durationSeconds Int              @default(0)
  publishedAt     DateTime?
  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id])
  topic           Topic?           @relation(fields: [topicId], references: [id])
  teacher         User?            @relation(fields: [teacherId], references: [id])
  assets          LessonAsset[]
  progress        LessonProgress[]
  ratings         LessonRating[]
  doubts          LessonDoubt[]
  chunks          LessonChunk[]

  @@unique([moduleId, slug])
}

model LessonAsset {
  id        String          @id @default(cuid())
  lessonId  String
  type      LessonAssetType
  url       String
  metadata  Json?
  createdAt DateTime        @default(now())
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, type])
}

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  watchedSeconds Int      @default(0)
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LessonRating {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LessonDoubt {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  message   String
  answer    String?
  answeredAt DateTime?
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id             String             @id @default(cuid())
  code           String             @unique
  kind           QuestionKind
  statement      String
  alternatives   Json?
  correctAnswer  String?
  year           Int
  boardId        String
  careerId       String
  subjectId      String
  topicId        String?
  institutionId  String
  positionId     String
  sourceExam     String?
  explanation    String?
  board          Board              @relation(fields: [boardId], references: [id])
  career         Career             @relation(fields: [careerId], references: [id])
  subject        Subject            @relation(fields: [subjectId], references: [id])
  topic          Topic?             @relation(fields: [topicId], references: [id])
  institution    Institution        @relation(fields: [institutionId], references: [id])
  position       Position           @relation(fields: [positionId], references: [id])
  attempts       QuestionAttempt[]
  reactions      QuestionReaction[]
  favorites      QuestionFavorite[]
  simulationItems SimulationQuestion[]
  answers        QuestionAnswer[]
  aiAnswer       QuestionAiAnswer?
  notes          Note[]
  essayRubric    EssayRubric?
  submissions    EssaySubmission[]

  @@index([boardId, careerId, subjectId, topicId, year])
  @@index([institutionId, positionId])
}

model QuestionAttempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  simulationId   String?
  selectedAnswer String?
  isCorrect      Boolean?
  timeSeconds    Int
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  simulation     Simulation? @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([simulationId, questionId])
}

model QuestionFavorite {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

model Simulation {
  id            String               @id @default(cuid())
  userId        String
  title         String
  status        SimulationStatus     @default(IN_PROGRESS)
  filters       Json?
  questionCount Int
  startedAt     DateTime             @default(now())
  submittedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions     SimulationQuestion[]
  attempts      QuestionAttempt[]

  @@index([userId, status, createdAt])
}

model SimulationQuestion {
  id           String     @id @default(cuid())
  simulationId String
  questionId   String
  position     Int
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([simulationId, questionId])
  @@unique([simulationId, position])
  @@index([questionId])
}

model QuestionReaction {
  id           String         @id @default(cuid())
  userId       String
  questionId   String
  difficulty   DifficultyVote
  relevance    RelevanceVote
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model QuestionAnswer {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  body        String
  isOfficial  Boolean  @default(false)
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  votes       QuestionAnswerVote[]

  @@index([questionId, isOfficial])
}

model QuestionAnswerVote {
  answerId  String
  userId    String
  createdAt DateTime       @default(now())
  answer    QuestionAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([answerId, userId])
}

/// Chunk de transcricao com embedding para RAG por aula (pgvector).
model LessonChunk {
  id        String                       @id @default(cuid())
  lessonId  String
  position  Int
  content   String
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())
  lesson    Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId])
}

/// Uso de congelamento de ofensiva (streak freeze) — um por dia coberto.
model StreakFreezeUse {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model QuestionAiAnswer {
  id          String   @id @default(cuid())
  questionId  String   @unique
  body        String
  model       String
  createdAt   DateTime @default(now())
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AiUsageEvent {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  model          String
  feature        String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costCents      Int      @default(0)
  requestId      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([provider, model, createdAt])
}

model AiAutomationJob {
  id          String      @id @default(cuid())
  userId      String
  type        String
  status      AiJobStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?
  attempts    Int         @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AiReviewItem {
  id          String         @id @default(cuid())
  userId      String
  type        String
  entityType  String
  entityId    String?
  status      AiReviewStatus @default(PENDING)
  content     Json
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, type, createdAt])
  @@index([entityType, entityId])
}

model PrivacyConsent {
  id        String   @id @default(cuid())
  userId    String?
  subject   String
  version   String
  accepted  Boolean
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, subject, createdAt])
  @@index([subject, version, createdAt])
}

model DataSubjectRequest {
  id          String                   @id @default(cuid())
  userId      String
  type        DataSubjectRequestType
  status      DataSubjectRequestStatus @default(OPEN)
  description String?
  response    String?
  metadata    Json?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([type, status, createdAt])
}

model EssayRubric {
  id          String   @id @default(cuid())
  questionId  String   @unique
  criteria    Json
  maxScore    Float
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model EssaySubmission {
  id                 String   @id @default(cuid())
  questionId          String
  studentId           String
  assignedTeacherId   String?
  body                String
  aiScore             Float?
  aiFeedback          String?
  finalScore          Float?
  finalFeedback       String?
  correctedAt         DateTime?
  createdAt           DateTime @default(now())
  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student             User     @relation("EssayStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assignedTeacher     User?    @relation("EssayTeacher", fields: [assignedTeacherId], references: [id])

  @@index([assignedTeacherId, correctedAt])
}

model Note {
  id          String    @id @default(cuid())
  userId      String
  questionId  String?
  subjectId   String?
  topicId     String?
  title       String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question? @relation(fields: [questionId], references: [id])

  @@index([userId, subjectId, topicId])
}

model StudyList {
  id        String      @id @default(cuid())
  userId    String
  title     String
  isMyDay   Boolean     @default(false)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     StudyTask[]
}

model StudyTask {
  id          String       @id @default(cuid())
  listId      String
  title       String
  dueDate     DateTime?
  priority    TaskPriority @default(NORMAL)
  recurrence  String?
  completedAt DateTime?
  subjectId   String?
  topicId     String?
  parentId    String?
  list        StudyList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  parent      StudyTask?   @relation("Subtasks", fields: [parentId], references: [id])
  subtasks    StudyTask[]  @relation("Subtasks")
  focus       FocusSession[]

  @@index([listId, dueDate, completedAt])
}

model StudyGoal {
  id               String    @id @default(cuid())
  userId           String
  title            String
  period           String
  targetNetSeconds Int       @default(0)
  targetQuestions  Int       @default(0)
  targetFlashcards Int       @default(0)
  startsAt         DateTime  @default(now())
  endsAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
}

model UserProductivityPreference {
  userId          String    @id
  focusMode       FocusMode @default(POMODORO)
  pomodoroSeconds Int       @default(1500)
  breakSeconds    Int       @default(300)
  longBreakSeconds Int      @default(900)
  autoStartBreaks Boolean   @default(false)
  soundSettings   Json?
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FocusSession {
  id           String    @id @default(cuid())
  userId       String
  taskId       String?
  mode         FocusMode
  grossSeconds Int
  netSeconds   Int
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         StudyTask? @relation(fields: [taskId], references: [id])

  @@index([userId, startedAt])
}

model Flashcard {
  id             String   @id @default(cuid())
  userId         String
  subjectId      String?
  topicId        String?
  front          String
  back           String
  easeFactor     Float    @default(2.5)
  intervalDays   Int      @default(0)
  repetitions    Int      @default(0)
  dueAt          DateTime @default(now())
  favorite       Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model PostIt {
  id        String   @id @default(cuid())
  userId    String
  color     String
  body      String
  position  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  source    String
  points    Int
  ruleKey   String?
  idempotencyKey String? @unique
  revokedAt DateTime?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ruleKey, createdAt])
}

model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  scope     String
  period    String
  entries   Json
  createdAt DateTime @default(now())

  @@index([scope, period, createdAt])
}

model AchievementDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  icon        String
  requirement Json
  xpReward    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserAchievement[]
}

model UserAchievement {
  id            String                @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime              @default(now())
  metadata      Json?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, awardedAt])
}

model Challenge {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  title        String
  description  String
  status       ChallengeStatus        @default(DRAFT)
  metric       String
  targetValue  Int
  rewardXp     Int                    @default(0)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  participants ChallengeParticipant[]

  @@index([status, startsAt, endsAt])
}

model ChallengeParticipant {
  id              String    @id @default(cuid())
  challengeId     String
  userId          String
  progress        Int       @default(0)
  completedAt     DateTime?
  rewardClaimedAt DateTime?
  joinedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId, completedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  actionUrl String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Entitlement {
  id        String          @id @default(cuid())
  userId    String
  type      EntitlementType
  courseId  String?
  subscriptionId String?
  startsAt  DateTime        @default(now())
  endsAt    DateTime?
  source    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?         @relation(fields: [courseId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId, type, endsAt])
  @@index([subscriptionId])
}

model Plan {
  id                  String          @id @default(cuid())
  code                String          @unique
  name                String
  description         String
  interval            BillingInterval
  amountCents         Int
  currency            String          @default("BRL")
  entitlementType     EntitlementType
  courseId            String?
  provider            String          @default("stripe")
  providerPriceId     String?
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  subscriptions       Subscription[]
  payments            Payment[]
  course              Course?         @relation(fields: [courseId], references: [id])

  @@index([active, interval])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  provider               String
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  payments               Payment[]
  entitlements           Entitlement[]

  @@index([userId, status])
}

model Payment {
  id                 String        @id @default(cuid())
  userId             String
  courseId           String?
  planId             String?
  subscriptionId     String?
  couponId           String?
  provider           String
  providerPaymentId  String?       @unique
  providerCustomerId String?
  providerSubscriptionId String?
  idempotencyKey     String?       @unique
  amountCents        Int
  discountCents      Int           @default(0)
  currency           String        @default("BRL")
  status             PaymentStatus @default(PENDING)
  metadata           Json?
  paidAt             DateTime?
  failedAt           DateTime?
  canceledAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course?       @relation(fields: [courseId], references: [id])
  plan               Plan?         @relation(fields: [planId], references: [id])
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  coupon             Coupon?       @relation(fields: [couponId], references: [id])
  couponRedemptions  CouponRedemption[]

  @@index([userId, status, createdAt])
  @@index([subscriptionId, createdAt])
}

model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  description        String?
  percentOff         Int?
  amountOffCents     Int?
  maxRedemptions     Int?
  redeemedCount      Int      @default(0)
  startsAt           DateTime @default(now())
  endsAt             DateTime?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  payments           Payment[]
  redemptions        CouponRedemption[]

  @@index([active, startsAt, endsAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  paymentId String?
  amountCents Int
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([couponId, createdAt])
  @@index([userId, createdAt])
  @@index([paymentId])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, type, createdAt])
}

model FeatureFlag {
  key       FeatureFlagKey @id
  enabled   Boolean        @default(false)
  updatedAt DateTime       @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ModerationCase {
  id          String   @id @default(cuid())
  contentType String
  contentId   String
  action      String
  reason      String
  actorId     String
  createdAt   DateTime @default(now())

  @@index([contentType, contentId])
  @@index([actorId, createdAt])
}

model PsychologyProfessional {
  id        String   @id @default(cuid())
  name      String
  crp       String
  bio       String
  active    Boolean  @default(false)
  sessions  PsychologySession[]
}

model PsychologySession {
  id             String   @id @default(cuid())
  professionalId String
  studentId      String
  scheduledAt    DateTime
  status         String
  notes          String?
  professional   PsychologyProfessional @relation(fields: [professionalId], references: [id])
}

model MentalSupportContent {
  id          String   @id @default(cuid())
  title       String
  body        String
  category    String
  publishedAt DateTime?
}

model RecreioRoom {
  id        String   @id @default(cuid())
  title     String
  isOpen    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LiveClass {
  id          String   @id @default(cuid())
  title       String
  lessonId    String?
  provider    String
  externalId  String?
  scheduledAt DateTime
  startsAt    DateTime?
  endsAt      DateTime?
}

model ProfessorSubject {
  userId    String
  subjectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([userId, subjectId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  subjectId   String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  subject     User?    @relation("AuditSubject", fields: [subjectId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
