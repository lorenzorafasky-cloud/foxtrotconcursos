# Core
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3333
COOKIE_DOMAIN=localhost

# Database: use Neon in production and local Postgres in development.
# Use DATABASE_URL for application runtime and DIRECT_URL for Prisma migrations.
DATABASE_URL=postgresql://foxtrot:foxtrot@localhost:5432/foxtrot?schema=public
DIRECT_URL=postgresql://foxtrot:foxtrot@localhost:5432/foxtrot?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
PASSWORD_PEPPER=replace-with-password-pepper
TOTP_ISSUER=Foxtrot Concursos

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=foxtrot-assets
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=

# AI
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
TRANSCRIPTION_PROVIDER=cloudflare-workers-ai

# Payments
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email
RESEND_API_KEY=
MAIL_FROM=Foxtrot Concursos <contato@foxtrotconcursos.com.br>
